{
  "name": "stock-checker",
  "version": "1.0.0",
  "description": "Stock and price tracker for Flipkart with Telegram notifications and CLI management",
  "type": "module",
  "bin": {
    "stock": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli/index.ts",
    "auth:login": "tsx scripts/bootstrap-session.ts",
    "auth:verify": "tsx scripts/verify-session.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "stock-checker",
    "flipkart",
    "telegram",
    "playwright",
    "sqlite"
  ],
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "croner": "^9.0.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
